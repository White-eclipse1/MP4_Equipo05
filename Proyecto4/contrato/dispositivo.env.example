# Configuracion del programa del dispositivo edge (contrato en docs/contrato-capturas.md).
# Copiala a `.env` junto al programa (`.env` esta ignorado por Git) y llena lo que falta.
# NUNCA escribas aqui el token real: este archivo va al repositorio.

# Receptor de capturas del portal desplegado. En local: http://<ip-de-la-laptop>:8000/api/p4/capturas
P4_RECEPTOR_URL=https://54-80-197-58.sslip.io/api/p4/capturas
# Token Bearer del dispositivo; se comparte por un canal privado.
P4_TOKEN_DISPOSITIVO=
# Identidad del dispositivo en cada evento: letras, digitos, '.', '_' o '-' (1 a 64).
P4_DEVICE_ID=edge01
# Modelo optimizado que carga el dispositivo. El programa recalcula su SHA-256 al
# arrancar, lo muestra y se niega a clasificar si no coincide con P4_MODEL_SHA256.
P4_MODEL_PATH=
P4_MODEL_VERSION=
P4_MODEL_SHA256=
# Registro local: cada captura deja aqui su JPEG y su evento ANTES de enviarse.
P4_CAPTURAS_DIR=capturas
