{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarCapturasYModelos",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::p4-capturas-474665692638",
      "Condition": {"StringLike": {"s3:prefix": ["edge-capturas/*", "modelos/*"]}}
    },
    {
      "Sid": "LeerCapturasYModelos",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::p4-capturas-474665692638/edge-capturas/*",
        "arn:aws:s3:::p4-capturas-474665692638/modelos/*"
      ]
    }
  ]
}
