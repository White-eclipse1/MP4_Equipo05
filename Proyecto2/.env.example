# ---------------------------------------------------------------------------
# Plantilla de configuracion. Copia este archivo a `.env` y ajusta los valores.
#
#   cp .env.example .env      (o deja que `python scripts/up.py` lo haga por ti)
#
# Este es el UNICO lugar con credenciales del proyecto: ni el codigo fuente ni
# `docker-compose.yml` tienen valores por defecto para secretos. Si falta una
# variable, la app aborta (`src/dataset_quality/settings.py`) y compose se niega
# a arrancar (sintaxis `${VAR:?}`). `.env` esta en .gitignore y .dockerignore:
# nunca se commitea ni entra en la imagen.
# ---------------------------------------------------------------------------

# --- Aplicacion -------------------------------------------------------------
APP_ENV=development
# Puerto publicado en el host. Dentro de Docker la app siempre escucha en 8000.
APP_PORT=8000
LOG_LEVEL=info

# --- Dataset Copilot (MCP) -------------------------------------------------
# La clave es opcional al arrancar: sin ella el resto de la plataforma sigue
# disponible y solo `/api/copilot/chat` responde 503 con instrucciones.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Fuera de Compose sirve para ejecutar el sidecar localmente. Compose lo
# reemplaza por `http://mcp:8001/mcp`, que no se publica al host.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# --- MariaDB ----------------------------------------------------------------
# DB_HOST/DB_PORT son los valores para ejecutar la app FUERA de Docker.
# Dentro de compose el servicio `app` los sobreescribe a `mariadb:3306`
# (topologia de red, no secreto).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dataset_quality_db
DB_USER=dq_user
DB_PASSWORD=dq_local_password
DB_ROOT_PASSWORD=dq_root_local_password

# --- MinIO (S3-compatible, equivalente local de S3 en PROD) -----------------
# Igual que arriba: en compose el servicio `app` usa el host `minio:9000`.
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=dq_minio_admin
MINIO_ROOT_PASSWORD=dq_minio_local_password
MINIO_USE_SSL=false
# Bucket de releases inmutables del dataset (equivale a s3://dataset-releases)
MINIO_BUCKET_RELEASES=dataset-releases
# Bucket del remote de DVC (equivale a s3://dvc-cache)
MINIO_BUCKET_DVC_CACHE=dvc-cache
# Binarios de las imagenes del dataset crudo
MINIO_BUCKET_IMAGES=dataset-images

# PROD: perfil AWS explicito en el host, credenciales temporales OIDC en CI.
PROD_BUCKET_RELEASES=dataset-quality-releases-750702272375
PROD_REGION=us-east-1

# --- Proyecto 1 (portal de anotacion, fuente del COCO crudo) ----------------
# Solo se usa al exportar; el pipeline nunca lo consulta.
MP1_BASE_URL=http://localhost:3000

# --- Proyecto 3 --------------------------------------------------------------
# Puerto publicado de MLflow (tracking de experimentos). Opcional: 5000 por defecto.
MLFLOW_PORT=5000
# Perfil de ~/.aws con el que el servicio de inferencia lee el modelo publicado
# en S3 (solo el nombre; las llaves se quedan en ~/.aws). Vacio = perfil default.
P3_AWS_PROFILE=

# --- Proyecto 4: Capturas Edge (docs/decisiones.md §5) -----------------------
# Destino en S3 de las capturas del dispositivo (imagen + registro por evento).
P4_CAPTURES_BUCKET=dataset-quality-releases-750702272375
P4_CAPTURES_PREFIX=edge-captures/
P4_AWS_REGION=us-east-1
# Perfil de ~/.aws (solo el nombre) SOLO para desarrollo local. Vacio = cadena
# estandar de boto3 (rol de instancia en el despliegue; sin llaves personales).
P4_AWS_PROFILE=
# Token que el dispositivo envia en `Authorization: Bearer ...`. Vacio = el
# receptor rechaza todos los envios (503). Genera uno propio en tu `.env`:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
P4_DEVICE_TOKEN=
# Versiones del modelo aceptadas, `version=sha256` separadas por coma.
P4_ACCEPTED_MODELS=1.0.0-int8.1=ca689c4e1478ccca7821dffaba8f07886bd9609a8aa3cec7450d9f875fbd69c0
